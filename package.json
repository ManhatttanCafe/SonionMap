{
  "name": "sonion-maper",
  "private": true,
  "version": "1.0.0",
  "description": "Local-first graph editor and MCP server for mapping .onion links.",
  "keywords": [
    "tor",
    "onion",
    "osint",
    "graph",
    "mcp",
    "cli"
  ],
  "type": "module",
  "bin": {
    "sonionmap": "bin/sonionmap",
    "sonionmap-mcp": "bin/sonionmap-mcp"
  },
  "scripts": {
    "dev": "vite",
    "dev:all": "node scripts/dev-all.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "server": "tsx server/api.ts",
    "mcp": "tsx server/mcp.ts",
    "cli": "tsx server/cli.ts",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "check": "npm run build && npm run typecheck:server"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "~5.7.2",
    "vite": "^6.1.0"
  }
}
